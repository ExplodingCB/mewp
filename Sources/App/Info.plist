<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mewp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Mewp</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Mewp scans your Desktop to find large and old files.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Mewp scans your Documents to find large and old files.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Mewp scans your Downloads for junk, duplicates, and old files.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mewp only measures the size of your Photos library so it appears in the storage map. It never opens, reads, or uploads your photos.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Mewp scans connected volumes to empty their trash and find large files.</string>
</dict>
</plist>
